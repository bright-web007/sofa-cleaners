# Site Configuration
NEXT_PUBLIC_SITE_URL=https://sofacleaner.org
NEXT_PUBLIC_SITE_NAME=SofaCleaner.org

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Contact Information
NEXT_PUBLIC_CONTACT_PHONE=+44 20 7946 0958
NEXT_PUBLIC_CONTACT_EMAIL=info@sofacleaner.org
NEXT_PUBLIC_SUPPORT_EMAIL=support@sofacleaner.org

# Business Information
NEXT_PUBLIC_BUSINESS_HOURS="Monday to Friday: 8 AM - 6 PM, Saturday: 9 AM - 5 PM, Sunday: 10 AM - 4 PM"

# Social Media
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/sofacleanerorg
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/sofacleanerorg
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/sofacleanerorg

# API Keys (Optional - for future integrations)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Messaging Services
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Email Service (Optional)
# SENDGRID_API_KEY=your_sendgrid_key
# MAILGUN_API_KEY=your_mailgun_key

# Database (when moving from JSON to real database)
# DATABASE_URL=your_database_url
# DATABASE_DIRECT_URL=your_direct_database_url

# Authentication (when adding user accounts)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your_nextauth_secret

# File Upload (when adding image uploads)
# CLOUDINARY_CLOUD_NAME=your_cloudinary_name
# CLOUDINARY_API_KEY=your_cloudinary_key
# CLOUDINARY_API_SECRET=your_cloudinary_secret
